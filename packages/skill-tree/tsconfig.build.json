{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"outDir": "dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"tsBuildInfoFile": "tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
